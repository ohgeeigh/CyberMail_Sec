# Copy this file to .env and fill in local values.
# Never commit .env. Never put real production passwords in this repository.

# Base URL of the application API you are allowed to test. No trailing slash.
API_BASE_URL=http://127.0.0.1:8000

# Identifier of a report the allowed test user may read in the local environment.
TEST_REPORT_ID=1

# Account that should be allowed to read the sample report.
TEST_USER_EMAIL=
TEST_USER_PASSWORD=
# Short-lived token for local runs. Prefer implementing login in the tests.
TEST_USER_TOKEN=

# Account that must be denied the same report.
TEST_DENIED_USER_EMAIL=
TEST_DENIED_USER_PASSWORD=
TEST_DENIED_USER_TOKEN=
